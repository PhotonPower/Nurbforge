{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja"
    },
    { "name": "debug",   "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "ci",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "NF_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "msvc",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "ci",      "configurePreset": "ci" },
    { "name": "msvc",    "configurePreset": "msvc", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "debug",   "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "ci",      "configurePreset": "ci",      "output": { "outputOnFailure": true } },
    { "name": "msvc",    "configurePreset": "msvc",    "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
